# Where the OAuth authorize / token endpoints live. The SDK appends
# `/oauth2/authorize` and `/oauth2/token` to this value, so point it at the
# auth base — NOT the bare host. Against production that is:
#   MODEL_MATCH_ISSUER=https://auth.modelmatch.com/api/auth
# (the bare https://auth.modelmatch.com would 404 — the endpoints live under /api/auth).
MODEL_MATCH_ISSUER=http://localhost:3009

# Where the Model Match REST API lives. The api-sdk reads MMR_API_URL by default.
MMR_API_URL=http://localhost:3001

# Confidential OAuth app credentials. NEVER prefix these with VITE_ — they must
# never reach the browser bundle.
MODEL_MATCH_CLIENT_ID=replace-me
MODEL_MATCH_CLIENT_SECRET=replace-me

# Must exactly match the redirect URI you registered with the OAuth app.
MODEL_MATCH_REDIRECT_URI=http://localhost:3000/oauth/callback
