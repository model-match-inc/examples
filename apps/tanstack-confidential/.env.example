# TanStack Start (confidential) — environment variables
# Generated by @model-match/create — edit template.json then `npm run gen`.

# The SDK appends /oauth2/authorize and /oauth2/token to this value. Point it at the auth base, NOT the bare host (the bare host 404s — endpoints live under /api/auth).
MODEL_MATCH_ISSUER=https://auth.modelmatch.com/api/auth

# Model Match REST API base URL
MMR_API_URL=https://api.modelmatch.com

# OAuth client ID
MODEL_MATCH_CLIENT_ID=replace-me

# NEVER prefix this with VITE_ — it must never reach the browser bundle.
# (secret — never commit a real value)
MODEL_MATCH_CLIENT_SECRET=replace-me

# Must exactly match the redirect URI registered with your OAuth app.
MODEL_MATCH_REDIRECT_URI=http://localhost:3000/oauth/callback
