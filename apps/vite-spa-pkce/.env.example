# Vite SPA (PKCE) — environment variables
# Generated by @model-match/create — edit template.json then `npm run gen`.

# A public OAuth client — there is NO secret. This value is inlined into the browser bundle, which is fine for a PKCE client.
VITE_MODEL_MATCH_CLIENT_ID=replace-me

# The SDK appends /oauth2/authorize and /oauth2/token to this value. Point it at the auth base, NOT the bare host (the bare host 404s — endpoints live under /api/auth).
VITE_MODEL_MATCH_ISSUER=https://auth.modelmatch.com/api/auth

# Model Match REST API base URL
VITE_MMR_API_URL=https://api.modelmatch.com

# Must exactly match the redirect URI registered with your OAuth app.
VITE_MODEL_MATCH_REDIRECT_URI=http://localhost:5173/oauth/callback
