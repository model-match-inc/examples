# A public OAuth client — there is NO secret. The Vite-prefixed vars below
# get inlined into the browser bundle, which is fine for a PKCE client.
VITE_MODEL_MATCH_CLIENT_ID=replace-me
# The SDK appends `/oauth2/authorize` and `/oauth2/token` to this value, so
# point it at the auth base — NOT the bare host. Against production that is:
#   VITE_MODEL_MATCH_ISSUER=https://auth.modelmatch.com/api/auth
# (the bare https://auth.modelmatch.com would 404 — endpoints live under /api/auth).
VITE_MODEL_MATCH_ISSUER=http://localhost:3009

# Where the Model Match REST API lives.
VITE_MMR_API_URL=http://localhost:3001

# Must exactly match the redirect URI you registered with the OAuth app.
VITE_MODEL_MATCH_REDIRECT_URI=http://localhost:5173/oauth/callback
