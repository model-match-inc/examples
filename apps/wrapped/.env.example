# Year in Review (Wrapped) — environment variables
# Generated by @model-match/create — edit template.json then `npm run gen`.

# Create one in the Model Match dashboard. Sent as the x-api-key header, server-side only — it is never exposed to the browser.
# (secret — never commit a real value)
MODEL_MATCH_API_KEY=replace-me

# The loan originator whose year gets wrapped (e.g. 1036297).
MODEL_MATCH_NMLS_ID=replace-me

# Model Match REST API base URL
MMR_API_URL=https://api.modelmatch.com

# Year to review
REPORT_YEAR=2025
