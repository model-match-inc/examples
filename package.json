{
  "name": "@model-match/examples-monorepo",
  "private": true,
  "type": "module",
  "description": "Model Match API example apps + the tooling that scaffolds and deploys them.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "gen": "node scripts/gen.ts",
    "build": "npm run build -w @model-match/create",
    "typecheck": "npm run typecheck -w @model-match/create",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7"
  },
  "engines": {
    "node": ">=22.6"
  }
}
